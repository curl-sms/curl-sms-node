{
  "name": "curl-sms",
  "version": "1.0.0",
  "description": "Official Node.js and TypeScript client for the curl-sms SMS API. Send SMS with one call.",
  "license": "MIT",
  "author": "curl-sms <help@curl-sms.com> (https://curl-sms.com)",
  "homepage": "https://curl-sms.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/curl-sms/curl-sms-node.git"
  },
  "bugs": {
    "url": "https://github.com/curl-sms/curl-sms-node/issues",
    "email": "help@curl-sms.com"
  },
  "keywords": [
    "sms",
    "sms-api",
    "sms-gateway",
    "curl-sms",
    "text-message",
    "rest-api",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "check": "publint --strict && attw --pack . --profile node16",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^22.20.7",
    "publint": "^0.3.25",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
